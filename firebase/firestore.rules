rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  TRCO APP · Reglas de seguridad de Firestore
//  Se publican solas con GitHub Actions (ver README), o a mano en
//  Firebase Console → Firestore Database → Reglas → Publicar.
//
//  Roles (campo `role` en /profiles/{uid}):
//    owner       = Dueño: puede todo y gestiona usuarios.
//    colaborador = puede solo lo que el Dueño le activó en `permissions`.
//  Los usuarios se crean SOLO desde las funciones (functions/index.js).
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function isMember() { return hasProfile() && me().active == true; }
    function isOwner() { return isMember() && me().role == 'owner'; }
    function can(p) {
      return isMember() && (me().role == 'owner' || (me().role == 'colaborador' && me().permissions[p] == true));
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Solo indica si ya existe el Dueño (para mostrar la pantalla de primera vez).
    match /meta/owner {
      allow get: if true;
      allow list, write: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isMember());
      // Cada quien solo puede marcar que ya cambió su contraseña temporal.
      allow update: if signedIn() && uid == request.auth.uid
        && onlyChanges(['must_change_password'])
        && request.resource.data.must_change_password == false;
      allow create, delete: if false;
    }

    // Catálogos (tipos, tallas, canales…): todos leen, solo el Dueño cambia.
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    // Productos: inventario completo con permiso "inventario". Vender o recibir
    // producción solo puede mover el stock.
    match /products/{id} {
      allow read: if isMember();
      allow create, delete: if can('inventario');
      allow update: if can('inventario')
        || ((can('vender') || can('borrar_ventas') || can('produccion')) && onlyChanges(['stock']));
    }

    match /drops/{id} {
      allow read: if isMember();
      allow write: if can('inventario');
    }

    // Ventas: registrar, actualizar (estado/pagos), cancelar/eliminar.
    match /sales/{id} {
      allow read: if isMember();
      allow create: if can('vender');
      allow update: if (can('editar_ventas') && request.resource.data.status != 'cancelado' && resource.data.status != 'cancelado')
        || can('borrar_ventas')
        || (can('clientes') && onlyChanges(['customer_id']));
      allow delete: if can('borrar_ventas');
    }

    match /sale_items/{id} {
      allow read: if isMember();
      allow create: if can('vender');
      allow update: if can('inventario') && onlyChanges(['product_id']);
      allow delete: if can('borrar_ventas');
    }

    match /customers/{id} {
      allow read: if isMember();
      allow create: if can('vender') || can('clientes');
      allow update, delete: if can('clientes');
    }

    match /production/{id} {
      allow read: if isMember();
      allow create, delete: if can('produccion');
      allow update: if can('produccion') || (can('inventario') && onlyChanges(['product_id']));
    }

    // Eventos: solo el Dueño los crea, edita y cierra. Al vender en modo evento
    // (o cancelar esas ventas) se mueve el stock de la maleta (campo items).
    match /events/{id} {
      allow read: if isMember();
      allow create, delete: if isOwner();
      allow update: if isOwner() || ((can('vender') || can('borrar_ventas')) && onlyChanges(['items']));
    }

    // Promociones: todos las leen (para aplicarlas al vender); solo el Dueño las crea.
    match /promos/{id} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    match /expenses/{id} {
      allow read, write: if can('gastos');
    }
  }
}
